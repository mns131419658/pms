# ═══════════════════════════════════════════════════════════
#  設定檔範本
#
#  用法：把這個檔案「複製」一份，改名成 .env，再把值填在等號後面。
#        （.env 已被 .gitignore 擋住，不會上傳到 GitHub）
#
#  完全不填也可以正常使用：系統會自動改用本機資料夾存放資料，
#  適合還沒進行到第 5、6 章的時候。
# ═══════════════════════════════════════════════════════════

# ── 第 5 章：免費資料庫（Neon）──────────────────────────
# 從 Neon 專案頁複製「Pooled connection」的連線字串，整串貼進來。
# 結尾的 ?sslmode=require 不能漏掉。
DATABASE_URL=

# ── 第 6 章：Google 雲端硬碟（存放專案結案附件 / 自動備份）──
# 從 Google Cloud Console 的「憑證」頁取得
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 用 get-token.js 取得
GOOGLE_REFRESH_TOKEN=
# 雲端硬碟資料夾網址最後那一串英數字
GOOGLE_FOLDER_ID=

# ── 每週自動備份 ──────────────────────────────────────
# 讓外部排程服務 (例如 cron-job.org) 呼叫 /api/admin/backup-now 時用來驗證身分，
# 隨便設一組不容易猜到的字串即可，呼叫時帶在 X-Backup-Secret 標頭。
BACKUP_SECRET=

# ── 選用設定（不填則使用預設值）────────────────────────
# 服務埠號，預設 3000
# PORT=3000

# 第一次啟動時建立的管理者密碼，預設 0000
# 只在「資料庫完全沒有帳號」時有作用
# ADMIN_PASSWORD=
